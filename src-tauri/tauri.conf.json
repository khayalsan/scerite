{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "scerite",
  "version": "0.3.0",
  "identifier": "dev.khayal.scerite",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "scerite",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhDOTkxNUU3MjE5MDkwOUIKUldTYmtKQWg1eFdaalBGRG5ncDFhV3gzZEN2MnlVc1NJREx4TytTNkVUSm9YYUVuNFM3MkNPdTcK",
      "endpoints": [
        "https://github.com/khayalsan/scerite/releases/latest/download/latest.json"
      ]
    }
  }
}
